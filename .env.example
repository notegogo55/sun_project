# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
#
# อีเมลที่ลงทะเบียนกับ JSOC (จำเป็นสำหรับการ export ข้อมูล)
# ลงทะเบียนได้ที่: http://jsoc.stanford.edu/ajax/register_email.html
SUNSEG_JSOC_EMAIL=your.email@example.com

# ลด memory fragmentation บน GPU ที่ VRAM น้อย (GTX 1650 = 4GB)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# คลังฟลักซ์โปรตอน GOES ราย 5 นาที (ไม่บังคับ)
# ทับค่า proton.root ใน backend/configs/data.yaml — ถ้าไม่ตั้งและ path ใน YAML ไม่มี
# อยู่จริง หน้าเว็บจะซ่อนแผง "Proton flux" ไปเฉยๆ ส่วนอื่นทำงานตามปกติ
SUNSEG_PROTON_DIR=D:/PositionFlare/GOES_proton_flux_integral/particle_clean

# ที่เก็บภาพ AIA ที่ประมวลผลแล้ว (ไม่บังคับ)
# ทับค่า aia.root ใน backend/configs/data.yaml — ค่าปริยายคือ data/processed/aia
# ในโปรเจค ตั้งค่านี้ต่อเมื่อต้องการย้ายไปไดรฟ์อื่น (ราว 3 MB ต่อเฟรม)
# ถ้ายังไม่ได้ดาวน์โหลด หน้าเว็บจะมีเฉพาะเลเยอร์ magnetogram ส่วนอื่นทำงานตามปกติ
#SUNSEG_AIA_DIR=D:/sunseg_aia
